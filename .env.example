# ════════════════════════════════════════════
# .env.example  —  copy to .env and fill in
# ════════════════════════════════════════════

# Server
PORT=10000
ENV=production
LOG_LEVEL=INFO

# Cache TTL in seconds (15 min default)
AI_CACHE_TTL=900

# CORS: comma-separated origins, or * for all
CORS_ORIGINS=*

# Data cache TTL in hours
CACHE_TTL_HOURS=4

# Optional: free API keys for more news sources
# GNEWS_API_KEY=your_key_here
# FINNHUB_KEY=your_key_here
# ALPHA_VANTAGE_KEY=your_key_here

# Optional: data directory (defaults to ./data)
# DATA_DIR=./data
ALPHA_VANTAGE_KEY=R7IZK2CE3325OBWJ
FINNHUB_KEY=d6itpe1r01qleu95hpb0d6itpe1r01qleu95hpbg
# ── GNews API (optional — better Indian stock news) ──
# Free key: https://gnews.io (100 req/day free)

GNEWS_API_KEY=8e077cf63e5e18c9dc97a7878e07c39f